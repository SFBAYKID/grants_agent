# grants_agent environment template.
# Copy to `.env` and fill in real values. The real `.env` is git-ignored — NEVER commit it.
# Every value below is a placeholder only.

# --- LLM: relevance scoring + contact extraction ---
ANTHROPIC_API_KEY=         # read by the Anthropic SDK
# Optional override for the model Grant reasons with.
GRANT_MODEL=

# --- Grant: the Slack chatbot (see config/grant_slack_manifest.yaml) ---
SLACK_BOT_TOKEN=            # xoxb-...  Bot User OAuth Token (from OAuth & Permissions after install)
SLACK_APP_TOKEN=           # xapp-...  App-Level Token with connections:write (Socket Mode)
SLACK_SIGNING_SECRET=      # read by Bolt itself, not by this codebase
SLACK_CHANNEL_ID=          # stable channel ID for Monarch Bot Playground only
SLACK_WORKSPACE_ID=        # exact workspace id checked by rich-card actions
PERSEQUOR_USER_ID=         # Slack member ID of @Persequor (referenced in docs/config, not read in code)

# Rich award-card campaign. Keep OFF until the separately approved shadow rollout.
# Fixed policy defaults in grant_watch/campaign/: one weekday post; deterministic
# 10:00-10:45 Pacific slot; hard 11:00 Pacific cutoff; 6-day completed-run freshness;
# 24-hour CRM freshness; 30-day contact/activity freshness.
GRANT_RICH_CARD_ENABLED=0
# The daily card's Pacific target band, tunable WITHOUT a deploy. Unset is silent and
# falls back to the built-in 10:00-11:30 band; a malformed value warns once.
DRIP_SLOT_START_PT=
DRIP_SLOT_END_PT=
# Per-state rep overrides, e.g. "PA=U08C1NBH875,CA=U01DFJWQQJ3". An unmapped state
# posts with NO mention rather than a guessed one; a malformed value tags nobody.
GRANT_TERRITORY_OWNERS=

# --- Firecrawl: site crawl for contact enrichment ---
FIRECRAWL_API_KEY=         # fc-...

# --- ZoomInfo: licensed contact/company data (the paid enrichment rung) ---
# DevPortal -> API Apps -> your app -> Client Secrets. These two mint 24h bearer
# tokens on demand, so nothing here expires; do NOT paste a bearer token instead.
# Contact SEARCH is free (names, titles, has-email/has-phone and do-not-call flags);
# ENRICH bills ONE CREDIT per returned record. Leave the budget at 0 and no paid
# pull can be authorized at all — the ledger refuses rather than assuming unlimited.
ZOOMINFO_CLIENT_ID=
ZOOMINFO_CLIENT_SECRET=
ZOOMINFO_MONTHLY_CREDITS=0   # account-wide ceiling; per-user numbers are display only

# --- Grant/RFP data sources ---
SAM_API_KEY=               # sam.gov -> Workspace -> Account Details -> Public API Key (Chase; email OTP)
# Blank means all 50 states plus DC; comma-separated codes narrow a local/test poll.
GRANT_WATCH_STATES=
# Third-party RFP aggregator polling. Live in production since 2026-07-22.
RFP_DISCOVERY_ENABLED=0

# --- Salesforce (CRM cross-reference for Grant: "you contacted them N days ago", account links) ---
# TEST against the SANDBOX (test.salesforce.com). PRODUCTION uses a SEPARATE Connected App + creds.
# Auth implemented by Grant: OAuth client credentials with a dedicated least-privilege
# integration user configured as the Connected App's run-as user.
SALESFORCE_MY_DOMAIN_URL=
SALESFORCE_CLIENT_ID=          # Connected App consumer key
SALESFORCE_CLIENT_SECRET=      # Connected App consumer secret
SALESFORCE_API_VERSION=        # optional pin, e.g. v61.0; blank uses the built-in default

# --- Salesforce Campaign writer (SEPARATE Connected App + least-privilege user) ---
# Keep disabled through preview/shadow testing. Writer permissions: read validation
# objects; CREATE only Campaign, CampaignMemberStatus, Lead, and CampaignMember.
# Never grant update/delete on Account, Contact, Opportunity, Task, or existing records.
SALESFORCE_CAMPAIGN_WRITES_ENABLED=0
SALESFORCE_WRITE_MY_DOMAIN_URL=https://your-domain--monarchdev.sandbox.my.salesforce.com
SALESFORCE_WRITE_CLIENT_ID=
SALESFORCE_WRITE_CLIENT_SECRET=
SALESFORCE_WRITE_ORG_ID=
SALESFORCE_WRITE_EXPECT_SANDBOX=1
# Comma-separated Grant channels allowed to WRITE to Salesforce. REQUIRED: an empty
# value now means NO channel may write (it used to mean "every channel Grant answers
# in", so an unset variable silently widened the write surface). DMs are never allowed.
GRANT_SALESFORCE_WRITE_CHANNEL_IDS=

# --- Grants production droplet (the grants-ops-guardian's ONLY door; scoped grants tenant) ---
# The guardian connects with an explicit, grants-only SSH command — NO ~/.ssh/config alias, so
# nothing global on the machine changes:
#   ssh -i ~/.ssh/grants_droplet -o IdentitiesOnly=yes "$GRANTS_DROPLET_USER@$GRANTS_DROPLET_HOST"
# IdentitiesOnly=yes presents ONLY the dedicated grants key (~/.ssh/grants_droplet), so the admin key
# (id_ed25519) loaded in the ssh-agent is NEVER offered. These two below are the whole connection.
GRANTS_DROPLET_HOST=          # droplet IP/host of the shared box where the grants tenant lives
GRANTS_DROPLET_USER=          # the non-sudo grants tenant Unix user (e.g. grantwatch)

# --- Database ---
# NOTE: there is no DATABASE_URL. The SQLite path is fixed in db.py; setting a URL
# here would have no effect. Postgres remains a future phase.

# TEST MODE: when set, all outreach email is addressed here instead of real contacts
# (real contact still displayed). Clear to go live.
OUTREACH_TEST_EMAIL=

# Grant -> Persequor outreach intake (localhost on the shared droplet)
PERSEQUOR_API_URL=http://127.0.0.1:8002
PERSEQUOR_API_KEY=            # shared secret, identical in both projects' .env

# --- Google Sheets export (Grant-owned; email stays Persequor's, data export is Grant's) ---
# Service-account JSON key (gitignored under secrets/); the account is a Content Manager on the
# "Grant Exports" shared drive so it can create/share export sheets without any personal storage.
GOOGLE_SA_KEY_PATH=secrets/google_sheets_sa.json
GRANT_EXPORTS_DRIVE_ID=       # the "Grant Exports" shared drive id (files.create parent)

# --- Resend (Grant emails a REP their own results — never a prospect) ---
# The key is SENDING-ONLY and scoped to monarchconnected.com. Grant resolves the
# recipient from the requester's Slack id through config/reps.json; there is no
# parameter anywhere that takes an address, so this cannot reach an outside inbox.
# Prospect outreach stays on the Persequor path with a human approving each send.
# QUOTE THE FROM ADDRESS. run_bot.sh does `set -a; source .env; set +a`, and an
# unquoted display-name form contains a space and <> — bash reads that as an
# assignment plus a redirection with no target, ABORTS AT THAT LINE, and silently
# stops exporting everything after it.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Grant <grant@monarchconnected.com>"
# Redirect REP email while testing. Deliberately separate from OUTREACH_TEST_EMAIL,
# which protects PROSPECT outreach: one switch for two different risks meant every
# rep's own results were silently going to the test mailbox while Grant told them
# "Sent it to you". Leave blank so a rep's list reaches the rep.
RESEND_TEST_EMAIL=
